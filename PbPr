<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚡️ وزارة الكهرباء - مدينة لوس سانتوس ⚡️</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://www.gstatic.com/firebasejs/10.13.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.13.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.13.1/firebase-database-compat.js"></script>
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #00d4aa 0%, #0066ff 50%, #ff6b6b 100%);
            --neon-green: #00ff88;
            --neon-blue: #00d4ff;
            --neon-yellow: #ffeb3b;
            --neon-purple: #d4a3ff;
            --orange-theme: #ff8c00;
            --orange-glow: #ff9500;
            --orange-dark: #e67e22;
            --dark-bg: #0a0a0a;
            --glass-bg: rgba(20, 20, 40, 0.4);
            --glass-border: rgba(255, 255, 255, 0.1);
            --glow-neon: 0 0 30px rgba(0, 255, 136, 0.5);
            --glow-pulse: 0 0 40px rgba(0, 212, 255, 0.6);
            --orange-glow-effect: 0 0 25px rgba(255, 140, 0, 0.7);
            --transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
            --shadow-neon: 0 25px 50px rgba(0, 0, 0, 0.5);
            --scrollbar-orange: linear-gradient(45deg, #ff8c00, #ff9500, #e67e22);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Cairo', sans-serif;
            background: radial-gradient(ellipse at center, #0a0a1f 0%, #000000 70%);
            color: white;
            overflow-x: hidden;
            position: relative;
            line-height: 1.7;
            font-weight: 400;
        }

        /* قائمة الحاضرين الجديدة */
        .online-users {
            position: fixed;
            top: 100px;
            right: 20px;
            width: 280px;
            background: rgba(20, 20, 40, 0.95);
            backdrop-filter: blur(30px);
            border: 2px solid rgba(255, 140, 0, 0.4);
            border-radius: 25px;
            padding: 25px;
            z-index: 999;
            box-shadow: var(--shadow-neon), var(--orange-glow-effect);
            transition: var(--transition);
        }

        .online-users h3 {
            color: var(--neon-yellow);
            font-size: 1.4rem;
            margin-bottom: 20px;
            text-align: center;
            text-shadow: 0 0 20px var(--neon-yellow);
        }

        .user-item {
            display: flex;
            align-items: center;
            padding: 12px;
            margin-bottom: 12px;
            background: rgba(255, 140, 0, 0.1);
            border-radius: 15px;
            border-right: 4px solid var(--orange-glow);
            transition: var(--transition);
            animation: userSlideIn 0.5s ease forwards;
            opacity: 0;
            transform: translateX(30px);
        }

        .user-item:nth-child(even) { background: rgba(0, 212, 255, 0.08); border-right-color: var(--neon-blue); }
        .user-item.you { background: linear-gradient(135deg, rgba(255,140,0,0.3), rgba(255,235,59,0.2)); border-right-color: var(--neon-yellow); box-shadow: 0 0 20px rgba(255,140,0,0.5); }

        @keyframes userSlideIn {
            to { opacity: 1; transform: translateX(0); }
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--orange-theme), var(--neon-yellow));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            font-weight: bold;
            margin-left: 12px;
            box-shadow: 0 0 15px rgba(255, 140, 0, 0.6);
        }

        .user-info { flex: 1; }
        .user-name { font-weight: 700; color: var(--neon-yellow); font-size: 1rem; }
        .user-time { font-size: 0.85rem; color: rgba(255,255,255,0.7); margin-top: 2px; }

        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--neon-green);
            box-shadow: 0 0 10px var(--neon-green);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.2); }
        }

        /* شاشة تسجيل الدخول */
        .login-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.95);
            backdrop-filter: blur(40px);
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 1;
            transition: opacity 0.5s ease;
        }

        .login-overlay.hidden { opacity: 0; pointer-events: none; }

        .login-container {
            background: rgba(15, 15, 35, 0.98);
            backdrop-filter: blur(40px);
            border: 3px solid transparent;
            border-image: linear-gradient(45deg, var(--orange-theme), var(--neon-yellow)) 1;
            border-radius: 35px;
            padding: 60px 50px;
            width: 90%;
            max-width: 500px;
            text-align: center;
            box-shadow: var(--shadow-neon), 0 0 80px rgba(255, 140, 0, 0.4);
            transform: scale(0.7) translateY(50px);
            transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
            overflow: hidden;
        }

        .login-overlay:not(.hidden) .login-container {
            transform: scale(1) translateY(0);
        }

        .login-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(transparent, rgba(255,140,0,0.1), transparent 30%);
            animation: rotate 4s linear infinite;
            z-index: -1;
        }

        .login-title {
            font-size: 2.5rem;
            background: linear-gradient(135deg, var(--orange-theme), var(--neon-yellow));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 40px;
            text-shadow: 0 0 30px rgba(255, 140, 0, 0.8);
        }

        .input-group {
            position: relative;
            margin-bottom: 30px;
        }

        .login-input {
            width: 100%;
            padding: 20px 25px;
            background: rgba(20, 20, 40, 0.8);
            border: 2px solid rgba(255, 140, 0, 0.3);
            border-radius: 20px;
            color: white;
            font-size: 1.1rem;
            font-family: 'Cairo', sans-serif;
            transition: var(--transition);
            text-align: right;
        }

        .login-input:focus {
            outline: none;
            border-color: var(--orange-glow);
            box-shadow: 0 0 25px rgba(255, 140, 0, 0.4);
            background: rgba(35, 35, 65, 0.9);
        }

        .login-btn, .create-account-btn {
            width: 100%;
            padding: 20px;
            background: linear-gradient(135deg, var(--orange-theme), var(--orange-glow));
            border: none;
            border-radius: 20px;
            color: white;
            font-size: 1.2rem;
            font-weight: 700;
            font-family: 'Cairo', sans-serif;
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(255, 140, 0, 0.4);
            position: relative;
            overflow: hidden;
        }

        .login-btn:hover, .create-account-btn:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 20px 50px rgba(255, 140, 0, 0.6);
        }

        .create-account-btn {
            background: linear-gradient(135deg, var(--neon-green), var(--neon-blue));
            box-shadow: 0 10px 30px rgba(0, 255, 136, 0.4);
        }

        .toggle-auth {
            background: none;
            border: 2px solid var(--neon-yellow);
            color: var(--neon-yellow);
            margin-top: 15px;
            padding: 12px 25px;
            border-radius: 15px;
            cursor: pointer;
            font-family: 'Cairo', sans-serif;
            transition: var(--transition);
        }

        .toggle-auth:hover {
            background: var(--neon-yellow);
            color: var(--dark-bg);
            transform: translateY(-2px);
        }

        .loading {
            display: none;
            margin: 20px 0;
        }

        .loading.active {
            display: block;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid rgba(255,255,255,0.2);
            border-top: 4px solid var(--neon-yellow);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* باقي الـ CSS كما هو بدون تغيير */
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                radial-gradient(2px 2px at 20px 30px, #00ff88, transparent),
                radial-gradient(2px 2px at 40px 70px, #00d4ff, transparent),
                radial-gradient(1px 1px at 90px 40px, #ffeb3b, transparent),
                radial-gradient(1px 1px at 130px 80px, #d4a3ff, transparent),
                radial-gradient(3px 3px at 160px 120px, var(--orange-theme), transparent),
                radial-gradient(1.5px 1.5px at 200px 90px, var(--orange-glow), transparent);
            background-repeat: repeat;
            background-size: 250px 120px;
            animation: starfield 60s linear infinite;
            z-index: -2;
            opacity: 0.9;
        }

        body::after {
            content: '';
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(rgba(0, 255, 136, 0.08) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 212, 255, 0.08) 1px, transparent 1px),
                linear-gradient(rgba(255, 140, 0, 0.05) 2px, transparent 2px);
            background-size: 70px 70px;
            z-index: -1;
            animation: gridMove 25s linear infinite;
        }

        @keyframes starfield { 
            0% { transform: translateY(0px); } 
            50% { transform: translateY(-100px) scale(1.1); }
            100% { transform: translateY(-200px); } 
        }
        
        @keyframes gridMove { 
            0%, 100% { transform: translate(0, 0); } 
            33% { transform: translate(20px, 25px); }
            66% { transform: translate(40px, 15px); }
        }

        .header {
            position: fixed; top: 0; width: 100%;
            background: rgba(10, 10, 26, 0.97); backdrop-filter: blur(25px);
            z-index: 1000; padding: 18px 0; transition: var(--transition);
            border-bottom: 2px solid transparent;
            background-image: linear-gradient(rgba(255,255,255,0.1), rgba(255,255,255,0.1)), var(--scrollbar-orange);
            background-size: 0 2px;
            background-repeat: no-repeat;
            background-position: left bottom;
        }

        .header.scrolled {
            border-bottom-color: var(--orange-theme);
            background-size: 100% 2px;
            box-shadow: 0 8px 35px rgba(255, 140, 0, 0.2);
        }

        .nav-container {
            max-width: 1400px; margin: 0 auto;
            display: flex; justify-content: space-between; align-items: center;
            padding: 0 45px;
        }

        .logo {
            font-size: 2rem; font-weight: 900;
            background: linear-gradient(135deg, var(--orange-theme), var(--orange-glow), var(--neon-yellow));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent; background-clip: text;
            text-shadow: 0 0 25px rgba(255, 140, 0, 0.8);
            animation: logoGlow 2.5s ease-in-out infinite alternate;
            position: relative;
        }

        .logo::after {
            content: '⚡️'; position: absolute; top: -10px; right: -35px;
            font-size: 1.5rem; animation: boltPulse 1.5s infinite;
        }

        @keyframes logoGlow {
            from { filter: drop-shadow(0 0 20px rgba(255, 140, 0, 0.6)); }
            to { filter: drop-shadow(0 0 45px rgba(255, 149, 0, 0.9)); }
        }

        @keyframes boltPulse {
            0%, 100% { opacity: 0.7; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.2); }
        }

        .user-status {
            background: linear-gradient(135deg, var(--neon-green), var(--neon-blue));
            padding: 8px 20px;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 600;
            box-shadow: 0 5px 20px rgba(0, 255, 136, 0.3);
        }

        .hero {
            height: 100vh; display: flex; flex-direction: column;
            justify-content: center; align-items: center; text-align: center;
            padding: 25px; position: relative;
            animation: heroSlide 2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        @keyframes heroSlide {
            0% { opacity: 0; transform: translateY(120px) scale(0.75); }
            50% { opacity: 0.7; transform: translateY(-10px) scale(1.02); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        .hero-logo {
            width: 300px; border: 5px solid transparent; border-radius: 50%;
            padding: 20px; 
            background: linear-gradient(45deg, var(--neon-green), var(--neon-blue), var(--orange-theme), var(--neon-yellow));
            background-clip: padding-box, border-box;
            box-shadow: 0 0 40px rgba(255, 140, 0, 0.6), 0 0 80px rgba(0, 255, 136, 0.4);
            animation: logoFloat 7s ease-in-out infinite, rotate3D 25s linear infinite;
            transition: var(--transition); cursor: pointer;
            position: relative;
        }

        .hero-logo::before {
            content: '⚡️'; position: absolute; top: 15px; left: 15px;
            font-size: 2rem; animation: rotate 3s linear infinite;
            text-shadow: 0 0 20px var(--orange-glow);
        }

        .hero-logo:hover {
            transform: scale(1.2) rotateY(720deg);
            box-shadow: 0 0 100px rgba(255, 140, 0, 0.9), 0 0 150px rgba(0, 212, 255, 0.6);
            border-color: var(--orange-glow);
        }

        @keyframes logoFloat {
            0%, 100% { transform: translateY(0px) rotateY(0deg); }
            33% { transform: translateY(-20px) rotateY(120deg); }
            66% { transform: translateY(-35px) rotateY(240deg); }
        }

        @keyframes rotate3D { from { transform: rotateY(0deg) rotateX(10deg); } to { transform: rotateY(360deg) rotateX(10deg); } }
        @keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        .hero-title {
            font-size: clamp(3.2rem, 11vw, 6.5rem); 
            background: linear-gradient(135deg, var(--orange-theme), var(--orange-glow), var(--neon-yellow));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text; margin: 35px 0; font-weight: 900; letter-spacing: 4px;
            text-shadow: 0 0 35px rgba(255, 140, 0, 0.8);
            animation: titlePulse 2.2s ease-in-out infinite alternate;
            position: relative;
        }

        .hero-title::after {
            content: ''; position: absolute; bottom: -15px; left: 50%;
            transform: translateX(-50%); width: 80px; height: 4px;
            background: var(--scrollbar-orange); border-radius: 2px;
            box-shadow: 0 0 15px var(--orange-glow);
        }

        @keyframes titlePulse {
            from { filter: drop-shadow(0 0 25px rgba(255, 140, 0, 0.6)); }
            to { filter: drop-shadow(0 0 50px rgba(255, 149, 0, 0.9)); }
        }

        .typewriter { 
            font-size: 1.8rem; 
            background: linear-gradient(45deg, var(--orange-theme), var(--neon-yellow));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            margin: 25px 0; font-weight: 700; min-height: 60px; 
            text-shadow: 0 0 25px rgba(255, 140, 0, 0.8);
            position: relative; overflow: hidden;
        }

        .typewriter::after {
            content: '|'; animation: blink 1s infinite;
            margin-right: 5px; color: var(--orange-glow);
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        .subtitle {
            font-size: 1.5rem; 
            background: linear-gradient(135deg, var(--neon-blue), var(--orange-glow));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            letter-spacing: 10px; font-weight: 800; margin-top: 30px; 
            animation: subtitleGlow 3.5s ease-in-out infinite alternate;
            text-shadow: 0 0 20px rgba(0, 212, 255, 0.6);
        }

        @keyframes subtitleGlow {
            from { filter: drop-shadow(0 0 15px var(--neon-blue)); }
            to { filter: drop-shadow(0 0 40px var(--neon-blue)), drop-shadow(0 0 50px var(--orange-glow)); }
        }

        .content-section {
            padding: 140px 25px 100px; max-width: 1500px; margin: 0 auto;
            display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 50px;
        }

        .card {
            background: rgba(20, 20, 40, 0.7); backdrop-filter: blur(30px);
            border: 2px solid rgba(255, 140, 0, 0.3); border-radius: 35px;
            padding: 60px 40px; text-align: center; cursor: pointer; position: relative;
            overflow: hidden; transition: var(--transition); opacity: 0; transform: translateY(80px) scale(0.85);
            position: relative;
        }

        .card::before {
            content: ''; position: absolute; top: 0; left: -120%; width: 120%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 140, 0, 0.25), transparent);
            transition: left 0.8s ease;
        }

        .card:nth-child(1) { animation-delay: 0.3s; }
        .card:nth-child(2) { animation-delay: 0.5s; }
        .card:nth-child(3) { animation-delay: 0.7s; }
        .card:nth-child(4) { animation-delay: 0.9s; }
        .card:nth-child(5) { animation-delay: 1.1s; }
        .card:nth-child(6) { animation-delay: 1.3s; }

        .card.show { 
            opacity: 1; 
            transform: translateY(0) scale(1); 
            animation: cardBounce 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        @keyframes cardBounce {
            0% { transform: translateY(80px) scale(0.85); }
            60% { transform: translateY(-20px) scale(1.05); }
            100% { transform: translateY(0) scale(1); }
        }

        .card:hover::before { left: 100%; }

        .card:hover {
            transform: translateY(-30px) scale(1.08); 
            border-color: var(--orange-glow);
            box-shadow: var(--shadow-neon), var(--orange-glow-effect), inset 0 0 40px rgba(255, 140, 0, 0.15);
            background: rgba(35, 35, 65, 0.9);
        }

        .card-icon { 
            font-size: 4.5rem; margin-bottom: 30px; 
            background: linear-gradient(135deg, var(--orange-theme), var(--orange-glow), var(--neon-yellow));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            background-clip: text; 
            filter: drop-shadow(0 0 25px rgba(255, 140, 0, 0.7)); 
            transition: var(--transition);
            position: relative;
        }

        .card-icon::before {
            content: ''; position: absolute; top: -10px; right: -10px;
            width: 60px; height: 60px; background: radial-gradient(circle, var(--orange-glow), transparent);
            border-radius: 50%; opacity: 0.3; animation: iconRing 2s infinite;
        }

        @keyframes iconRing {
            0% { transform: scale(0.8); opacity: 0.4; }
            50% { transform: scale(1.2); opacity: 0.2; }
            100% { transform: scale(1.5); opacity: 0; }
        }

        .card:hover .card-icon { 
            transform: scale(1.4) rotate(15deg); 
            filter: drop-shadow(0 0 50px rgba(255, 140, 0, 0.9)); 
        }

        .card h2 { 
            font-size: 2rem; 
            background: linear-gradient(45deg, var(--neon-yellow), var(--orange-glow));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            margin-bottom: 25px; font-weight: 800; 
        }

        .card p { 
            color: rgba(255, 255, 255, 0.9); font-size: 1.2rem; line-height: 1.8; 
            position: relative;
        }

        .card p::after {
            content: ''; position: absolute; bottom: -10px; right: 0;
            width: 50px; height: 3px; background: var(--orange-theme);
            border-radius: 2px; box-shadow: 0 0 10px var(--orange-glow);
        }

        .modal {
            display: none; position: fixed; z-index: 9999; left: 0; top: 0;
            width: 100%; height: 100%; background: rgba(0, 0, 0, 0.94);
            backdrop-filter: blur(35px); opacity: 0; transition: opacity 0.6s ease;
        }

        .modal.active { display: flex; align-items: center; justify-content: center; opacity: 1; }

        .modal-content {
            background: rgba(15, 15, 35, 0.97); backdrop-filter: blur(35px);
            border: 3px solid transparent; 
            border-image: var(--scrollbar-orange) 1; border-radius: 45px; 
            width: 96%; max-width: 1100px; max-height: 92vh; 
            padding: 60px; position: relative; overflow-y: auto;
            transform: scale(0.65) translateY(60px); 
            transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: var(--shadow-neon), 0 0 120px rgba(255, 140, 0, 0.4);
        }

        .modal.active .modal-content { transform: scale(1) translateY(0); }

        .close {
            position: absolute; top: 30px; left: 35px; color: var(--neon-yellow);
            font-size: 2.8rem; cursor: pointer; transition: var(--transition);
            width: 70px; height: 70px; border-radius: 50%; display: flex;
            align-items: center; justify-content: center; 
            background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(15px);
            box-shadow: 0 0 20px rgba(255, 235, 59, 0.3);
        }

        .close:hover {
            transform: rotate(720deg) scale(1.3); 
            background: linear-gradient(45deg, var(--orange-theme), var(--neon-yellow));
            box-shadow: 0 0 40px rgba(255, 140, 0, 0.8), 0 0 60px rgba(255, 235, 59, 0.6);
        }

        .rules-list { 
            columns: 2; column-gap: 50px; text-align: right; font-size: 1.1rem;
            background: rgba(255, 140, 0, 0.08); padding: 30px; border-radius: 25px;
            border: 2px solid rgba(255, 140, 0, 0.3); box-shadow: inset 0 0 20px rgba(255, 140, 0, 0.1);
            max-height: 70vh; overflow-y: auto;
            line-height: 1.8;
        }

        @media (max-width: 768px) { 
            .rules-list { columns: 1; padding: 20px; }
            .online-users { 
                position: relative; 
                top: auto; 
                right: auto; 
                width: 100%; 
                margin: 20px 0; 
            }
        }

        .step-box {
            background: linear-gradient(135deg, rgba(255,140,0,0.12), rgba(255,149,0,0.08));
            border-right: 6px solid var(--orange-glow); border-radius: 25px;
            padding: 30px; margin-bottom: 25px; transition: var(--transition);
            position: relative; overflow: hidden; border: 1px solid rgba(255,140,0,0.2);
            box-shadow: 0 8px 25px rgba(255,140,0,0.15);
