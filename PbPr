    <script>
        // إعداد Firebase (استبدل ببيانات مشروعك)
        const firebaseConfig = {
            apiKey: "AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
            authDomain: "your-project.firebaseapp.com",
            databaseURL: "https://your-project-default-rtdb.firebaseio.com",
            projectId: "your-project",
            storageBucket: "your-project.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:xxxxxxxxxxxxxxxxxx"
        };

        // تهيئة Firebase
        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const database = firebase.database();

        let currentUser = null;
        let userRef = null;
        let usersListener = null;

        // Typewriter Effect
        const texts = [
            "⚡️ CONQUISE .. طموحنا إنارة المدينة ⚡️", 
            "🔌 التميز في خدمة المواطن 🔌", 
            "💡 معاً نبني مستقبل مشرق 💡",
            "🌟 الاحترافية هدفنا الأول 🌟"
        ];
        let textIndex = 0, charIndex = 0, isDeleting = false;

        function typeWriter() {
            const element = document.getElementById("typewriter");
            const currentText = texts[textIndex];

            if (isDeleting) {
                element.textContent = currentText.substring(0, charIndex - 1);
                charIndex--;
            } else {
                element.textContent = currentText.substring(0, charIndex + 1);
                charIndex++;
            }

            let typeSpeed = isDeleting ? 35 : 70;
            if (!isDeleting && charIndex === currentText.length) {
                typeSpeed = 2500; isDeleting = true;
            } else if (isDeleting && charIndex === 0) {
                isDeleting = false; 
                textIndex = (textIndex + 1) % texts.length; 
                typeSpeed = 600;
            }
            setTimeout(typeWriter, typeSpeed);
        }

        // تسجيل الدخول
        document.getElementById('loginBtn').addEventListener('click', async () => {
            const email = document.getElementById('loginEmail').value;
            const password = document.getElementById('loginPassword').value;
            
            if (!email || !password) {
                alert('يرجى ملء جميع الحقول');
                return;
            }

            showLoading(true);

            try {
                const result = await auth.signInWithEmailAndPassword(email, password);
                console.log('تم تسجيل الدخول بنجاح:', result.user);
            } catch (error) {
                console.error('خطأ في تسجيل الدخول:', error);
                alert('خطأ في تسجيل الدخول: ' + error.message);
            } finally {
                showLoading(false);
            }
        });

        // إنشاء حساب
        document.getElementById('registerBtn').addEventListener('click', async () => {
            const email = document.getElementById('registerEmail').value;
            const password = document.getElementById('registerPassword').value;
            
            if (!email || !password) {
                alert('يرجى ملء جميع الحقول');
                return;
            }

            if (password.length < 6) {
                alert('كلمة السر يجب أن تكون 6 أحرف على الأقل');
                return;
            }

            showLoading(true);

            try {
                const result = await auth.createUserWithEmailAndPassword(email, password);
                console.log('تم إنشاء الحساب بنجاح:', result.user);
            } catch (error) {
                console.error('خطأ في إنشاء الحساب:', error);
                alert('خطأ في إنشاء الحساب: ' + error.message);
            } finally {
                showLoading(false);
            }
        });

        // تبديل بين تسجيل الدخول وإنشاء الحساب
        document.getElementById('toggleAuth').addEventListener('click', () => {
            const loginForm = document.getElementById('loginForm');
            const registerForm = document.getElementById('registerForm');
            const toggleText = document.getElementById('toggleText');

            if (loginForm.style.display !== 'none') {
                loginForm.style.display = 'none';
                registerForm.style.display = 'block';
                toggleText.textContent = 'لديك حساب؟ تسجيل الدخول';
            } else {
                loginForm.style.display = 'block';
                registerForm.style.display = 'none';
                toggleText.textContent = 'ليس لديك حساب؟ إنشاء حساب جديد';
            }
        });

        function showLoading(show) {
            document.getElementById('loadingSpinner').classList.toggle('active', show);
            document.querySelectorAll('.login-btn').forEach(btn => btn.disabled = show);
        }

        // مراقب حالة المستخدم
        auth.onAuthStateChanged((user) => {
            if (user) {
                currentUser = user;
                document.getElementById('loginOverlay').classList.add('hidden');
                document.getElementById('userStatus').style.display = 'block';
                document.getElementById('currentUser').textContent = user.email.split('@')[0];
                document.getElementById('onlineUsers').style.display = 'block';
                
                // إضافة المستخدم لقائمة الحاضرين
                userRef = database.ref('onlineUsers/' + user.uid);
                userRef.set({
                    email: user.email,
                    displayName: user.email.split('@')[0],
                    timestamp: Date.now()
                });

                // الاستماع للحاضرين
                listenToOnlineUsers();
                
                // تحميل المحتوى
                revealCards();
            } else {
                currentUser = null;
                document.getElementById('loginOverlay').classList.remove('hidden');
                document.getElementById('userStatus').style.display = 'none';
                document.getElementById('onlineUsers').style.display = 'none';
            }
        });

        function listenToOnlineUsers() {
            const usersList = document.getElementById('usersList');
            
            usersListener = database.ref('onlineUsers').on('value', (snapshot) => {
                usersList.innerHTML = '';
                const users = [];
                
                snapshot.forEach((childSnapshot) => {
                    const userData = childSnapshot.val();
                    users.push({
                        id: childSnapshot.key,
                        ...userData
                    });
                });

                // ترتيب حسب وقت الدخول (الأحدث أولاً)
                users.sort((a, b) => b.timestamp - a.timestamp);

                users.forEach((user, index) => {
                    const timeAgo = getTimeAgo(user.timestamp);
                    const isCurrentUser = user.id === currentUser.uid;
                    
                    const userDiv = document.createElement('div');
                    userDiv.className = `user-item ${isCurrentUser ? 'you' : ''}`;
                    userDiv.style.animationDelay = `${index * 0.1}s`;
                    
                    userDiv.innerHTML = `
                        <div class="status-indicator"></div>
                        <div class="user-avatar">${user.displayName.charAt(0).toUpperCase()}</div>
                        <div class="user-info">
                            <div class="user-name">${user.displayName}</div>
                            <div class="user-time">${timeAgo}</div>
                        </div>
                    `;
                    
                    usersList.appendChild(userDiv);
                });

                if (users.length === 0) {
                    usersList.innerHTML = '<div style="text-align:center; color:rgba(255,255,255,0.5);">لا يوجد أحد متصل</div>';
                }
            });
        }

        function getTimeAgo(timestamp) {
            const now = Date.now();
            const diff = Math.floor((now - timestamp) / 1000);

            if (diff < 60) return 'الآن';
            if (diff < 3600) return `${Math.floor(diff/60)} دقيقة`;
            if (diff < 86400) return `${Math.floor(diff/3600)} ساعة`;
            return 'منذ يوم';
        }

        // تنظيف البيانات عند الخروج
        window.addEventListener('beforeunload', () => {
            if (userRef) {
                userRef.remove();
            }
            if (usersListener) {
                database.ref('onlineUsers').off('value', usersListener);
            }
        });

        // باقي الـ JavaScript كما هو
        function revealCards() {
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                setTimeout(() => {
                    card.classList.add('show');
                    card.style.animationDelay = `${0.2 + (index * 0.15)}s`;
                }, 400 + (index * 200));
            });
        }

        window.addEventListener('scroll', () => {
            const header = document.getElementById('header');
            if (window.scrollY > 100) {
                header.classList.add('scrolled');
                header.style.background = 'rgba(10, 10, 26, 0.99)';
                header.style.backdropFilter = 'blur(35px)';
                header.style.boxShadow = '0 15px 50px rgba(255, 140, 0, 0.25)';
            } else {
                header.classList.remove('scrolled');
                header.style.background = 'rgba(10, 10, 26, 0.97)';
                header.style.backdropFilter = 'blur(25px)';
                header.style.boxShadow = 'none';
            }
        });

